#!/usr/bin/env sh
# OpenSpec guard: any src/ or web/src/ change MUST accompany openspec/ updates.
#
# No bypass. No skip marker. No test-only exemption. If you touch code, you
# touch a proposal / archive / spec / BACKLOG entry in the same commit.
#
# Why: backlog / decisions / spec drift can't be tracked from memory or
# convention. A leak-proof commit-time gate is the only way to keep
# OpenSpec the actual source of truth.

STAGED=$(git diff --cached --name-only)

CODE_CHANGED=$(printf '%s\n' "$STAGED" | grep -cE '^(src/|web/src/)' || true)
SPEC_CHANGED=$(printf '%s\n' "$STAGED" | grep -cE '^openspec/' || true)

if [ "$CODE_CHANGED" -gt 0 ] && [ "$SPEC_CHANGED" -eq 0 ]; then
    cat >&2 <<'EOF'
ERROR: src/ or web/src/ changed but no openspec/ updates in this commit.

Every code change MUST accompany an OpenSpec change in the SAME commit:

  - openspec/changes/<slug>/proposal.md         (start of in-flight work)
  - openspec/changes/<slug>/tasks.md            (tasks log update)
  - openspec/archive/<date>-<slug>/             (closing an in-flight change)
  - openspec/specs/<area>/spec.md               (spec delta: Requirement / Scenario)
  - openspec/BACKLOG.md                         (newly discovered backlog item)

There is no override. Tests, comment-only fixes, refactors — all of them
need an OpenSpec touchpoint. If the change is too small to deserve a
spec edit, it should be folded into a proposal / archive / BACKLOG entry
that explains why it landed.

Staged files:
EOF
    printf '%s\n' "$STAGED" | sed 's/^/    /' >&2
    exit 1
fi

exit 0
