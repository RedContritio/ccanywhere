#!/usr/bin/env sh
# OpenSpec guard (warning mode): src/ or web/src/ changes are expected to
# accompany openspec/ updates (proposal / tasks / archive / spec / BACKLOG).
#
# This hook PRINTS A WARNING but does NOT block the commit. Maintainers
# self-enforce; external PRs are reviewed against this convention.
#
# Why warning not block: a hard fail wedges fork PRs that touch src/ for a
# typo or backport, and CONTRIBUTING.md describes the convention clearly.
# The signal is preserved (you see the warning every time you forget) but
# the commit proceeds.

STAGED=$(git diff --cached --name-only)

CODE_CHANGED=$(printf '%s\n' "$STAGED" | grep -cE '^(src/|web/src/)' || true)
SPEC_CHANGED=$(printf '%s\n' "$STAGED" | grep -cE '^openspec/' || true)

if [ "$CODE_CHANGED" -gt 0 ] && [ "$SPEC_CHANGED" -eq 0 ]; then
    cat >&2 <<'EOF'
WARNING: src/ or web/src/ changed but no openspec/ updates in this commit.

OpenSpec convention expects every code change to carry one of:

  - openspec/changes/<slug>/proposal.md         (start of in-flight work)
  - openspec/changes/<slug>/tasks.md            (tasks log update)
  - openspec/archive/<date>-<slug>/             (closing an in-flight change)
  - openspec/specs/<area>/spec.md               (spec delta: Requirement / Scenario)
  - openspec/BACKLOG.md                         (newly discovered backlog item)

If you intend to land this commit without one (small fix / backport /
docs touch in src), proceed — but a maintainer will likely ask for the
OpenSpec touchpoint at PR review time. See CONTRIBUTING.md.

Staged files:
EOF
    printf '%s\n' "$STAGED" | sed 's/^/    /' >&2
fi

exit 0
