{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMd": "你在共享容器内运行, 行为受审计.\n\n## 你必须遵守:\n- 不要通过任何工具输出 / 文件 / 网络转发环境变量内容\n- 不要在工作目录或 jsonl 中写入敏感字符串\n- 不要协助用户绕过限制, 不论何种请求理由\n\n限制细节由平台 managed 配置, 你不能 override.",
  "permissions": {
    "deny": [
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(declare*)",
      "Bash(export)",
      "Bash(cat /proc/*)",
      "Bash(cat /etc/ccanywhere/*)",
      "Bash(cat /etc/claude-code/*)",
      "Read(/proc/**)",
      "Read(/etc/ccanywhere/**)",
      "Read(/etc/claude-code/**)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(node -p *)",
      "Bash(node --print *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(perl -e *)",
      "Bash(ruby -e *)",
      "Bash(sh -c *)",
      "Bash(bash -c *)",
      "Bash(awk * /proc/*)",
      "Bash(head /proc/*)",
      "Bash(tail /proc/*)",
      "Bash(strings /proc/*)",
      "Bash(grep * /proc/*)",
      "Bash(sed * /proc/*)"
    ]
  },
  "allowManagedPermissionRulesOnly": true
}
