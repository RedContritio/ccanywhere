# Shared container image for non-owner user runtimes.
#
# claude binary is vendored via `npm install -g` (Linux build). Host
# claude is macOS Mach-O — Linux container can't exec it, so npm is
# the standard distribution channel. Per-user unix accounts are NOT
# baked into this image; user-sync.ts creates them via `docker exec
# useradd` when ccanywhere adds a user.

FROM node:22-alpine

# Packages:
#   iptables           — egress lock to api.anthropic.com
#   shadow             — useradd/userdel for per-user accounts
#   ca-certificates    — HTTPS 出站 (github / web_search / proxy)
#   bash               — entrypoint shell + manual debug
#   curl               — manual verify + 调试网络
RUN apk add --no-cache \
    iptables \
    shadow \
    ca-certificates \
    bash \
    curl

# claude code Linux build (npm). Pin a specific version on ccanywhere
# upgrade: `@anthropic-ai/claude-code@<version>`.
RUN npm install -g @anthropic-ai/claude-code

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# Managed-scope policy: deny rules + LLM soft-norm CLAUDE.md text (via
# `claudeMd` field) live in cc's anthropic-spec managed scope path.
# User-level settings.json / CLAUDE.md cannot override
# (allowManagedPermissionRulesOnly + managed precedence).
# ContainerUserSync no longer cp's per-user CLAUDE.md.
COPY managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod 0644 /etc/claude-code/managed-settings.json

# cc apiKeyHelper rotation script. settings.json's `apiKeyHelper`
# field points to this; cc calls it on 401 to swap stale
# ANTHROPIC_AUTH_TOKEN for a fresh 5-min bearer.
COPY cc-helper.sh /usr/local/bin/cc-helper.sh
RUN chmod 0755 /usr/local/bin/cc-helper.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
