{
  "name": "ccanywhere",
  "version": "0.0.1",
  "description": "Map a local Claude Code session to the web for remote access",
  "license": "Apache-2.0",
  "author": "RedContritio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedContritio/ccanywhere.git"
  },
  "bugs": {
    "url": "https://github.com/RedContritio/ccanywhere/issues"
  },
  "homepage": "https://github.com/RedContritio/ccanywhere#readme",
  "type": "module",
  "bin": {
    "ccanywhere": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "build:web": "pnpm -F ccanywhere-web build",
    "build:all": "pnpm run build:web && pnpm run build",
    "dev": "tsx watch src/cli.ts",
    "dev:web": "pnpm -F ccanywhere-web dev",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm run typecheck && pnpm -F ccanywhere-web typecheck",
    "lint": "eslint .",
    "lint:md": "node scripts/check-md-lines.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:all": "pnpm run test && pnpm -F ccanywhere-web test",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "fastify": "^5.10.0",
    "marked": "^18.0.6",
    "node-pty": "1.2.0-beta.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "tsup": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  }
}
